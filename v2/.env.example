# Copy to .env and fill in. .env is gitignored and must never be committed.
# These are NAMES ONLY — no real value belongs in this file or in the repository.

# Public. Shipped to the browser, safe by design: the anon key is protected by
# row-level security, not by secrecy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SITE_URL=

# SECRET. Set in the Supabase and Netlify dashboards only. Never in the repo,
# never in frontend code, never in a browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=
UNSUBSCRIBE_SECRET=
